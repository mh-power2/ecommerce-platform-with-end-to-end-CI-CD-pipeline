
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'moha044/ecommerce-postgres'
        IMAGE_TAG = '3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Database Files') {
            steps {
                sh '''
                    set -eu

                    test -f Database/Dockerfile
                    test -f Database/init/001-create-schema.sql

                    echo "Database files found."
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    docker build \
                        -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        Database
                '''
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE}:latest

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'PostgreSQL image built and pushed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the console output for the failing stage.'
        }
    }
}
